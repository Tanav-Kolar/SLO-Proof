# Copy this file to .env and fill in values locally.
# Do not commit .env. Do not put secrets in this repository.

ELASTIC_CLOUD_ENDPOINT=
ELASTIC_API_KEY=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SARVAM_API_KEY=
AWS_SESSION_TOKEN=
# User credentials are optional setup inputs for minting scoped keys.
ELASTIC_USERNAME=
ELASTIC_PASSWORD=
ELASTIC_INGEST_API_KEY=
ELASTIC_VERIFIER_API_KEY=
ELASTIC_CONTROLLER_API_KEY=
# Agent Builder / Workflows. Kibana endpoint can be derived for Elastic Cloud.
# A dedicated Kibana key is preferred; otherwise the setup key is used explicitly.
ELASTIC_KIBANA_ENDPOINT=
ELASTIC_KIBANA_API_KEY=
