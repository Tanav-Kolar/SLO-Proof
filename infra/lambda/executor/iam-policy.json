{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DescribeOneCluster",
      "Effect": "Allow",
      "Action": "eks:DescribeCluster",
      "Resource": "arn:aws:eks:__REGION__:__ACCOUNT_ID__:cluster/__CLUSTER_NAME__"
    },
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:__REGION__:__ACCOUNT_ID__:log-group:/aws/lambda/sloproof-executor:*"
    }
  ]
}
